diff --git a/apps/7guis/t/acceptance/flight.lisp b/apps/7guis/t/acceptance/flight.lisp
index bfb4785..624c811 100644
--- a/apps/7guis/t/acceptance/flight.lisp
+++ b/apps/7guis/t/acceptance/flight.lisp
@@ -91,3 +91,40 @@
   (assert-true (plusp (length (d:text-in driver :message))))
   (replace-text driver :start "01.01.2027")
   (assert-equal "" (d:text-in driver :message)))
+
+;;; --- E5 (notes/change-cost.org): two columns. The kind, the start date and the return date in a
+;;; column on the left; the Book button and the message in a column on the right, beginning at the
+;;; height of the first row. ---
+
+(defun left-of (a b)
+  "True if the whole of rectangle A is to the left of rectangle B."
+  (<= (+ (first a) (third a)) (first b)))
+
+(d:define-acceptance the-three-fields-are-in-a-column-on-the-left :flight
+  (let ((kind (d:rectangle driver :kind))
+        (start (d:rectangle driver :start))
+        (return (d:rectangle driver :return)))
+    (assert-true (= (first kind) (first start) (first return)))
+    (assert-true (< (second kind) (second start) (second return)))))
+
+(d:define-acceptance the-book-button-and-the-message-are-in-a-column-on-the-right :flight
+  (let ((kind (d:rectangle driver :kind))
+        (start (d:rectangle driver :start))
+        (return (d:rectangle driver :return))
+        (book (d:rectangle driver :book))
+        (message (d:rectangle driver :message)))
+    (dolist (field (list kind start return))
+      (assert-true (left-of field book)))
+    (assert-true (= (first book) (first message)))
+    (assert-true (< (second book) (second message)))
+    ;; The right column begins at the height of the first row.
+    (assert-true (= (second book) (second kind)))))
+
+(d:define-acceptance everything-is-still-in-the-window-and-booking-still-works :flight
+  (let ((message (d:rectangle driver :message))
+        (book (d:rectangle driver :book)))
+    (assert-true (>= (first book) 0))
+    (assert-true (>= (second book) 0))
+    (assert-true (<= (+ (first message) (third message)) 460)))
+  (d:click driver :book)
+  (assert-true (search "one-way flight" (d:text-in driver :message))))
