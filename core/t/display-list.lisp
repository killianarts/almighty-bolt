(defpackage #:almighty-bolt-core/t/display-list
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:dl #:almighty-bolt-core/display-list)))

(in-package #:almighty-bolt-core/t/display-list)

(defun red () (dl:pack-color 255 0 0))
(defun blue () (dl:pack-color 0 0 255))

;;; --- building ---

(define-test pack-color-puts-red-in-the-high-byte ()
  (assert-eql #xFF0000FF (dl:pack-color 255 0 0))
  (assert-eql #x00FF0080 (dl:pack-color 0 255 0 128))
  (assert-eql #x000000FF (dl:pack-color 0 0 0)))

(define-test a-new-list-is-empty ()
  (let ((list (dl:make-display-list :capacity 8)))
    (assert-eql 8 (dl:display-list-capacity list))
    (assert-eql 0 (dl:display-list-count list))))

(define-test commands-are-appended-in-order ()
  (let ((list (dl:make-display-list :capacity 8)))
    (assert-eql 0 (dl:push-rect list 1 2 30 40 (red)))
    (assert-eql 1 (dl:push-rounded-rect list 5f0 6f0 70f0 80f0 4f0 (blue)))
    (assert-eql 2 (dl:display-list-count list))
    (assert-eql dl:+command-rect+ (dl:display-list-kind list 0))
    (assert-eql dl:+command-rounded-rect+ (dl:display-list-kind list 1))
    (assert-eql 1f0 (dl:display-list-x list 0))
    (assert-eql 2f0 (dl:display-list-y list 0))
    (assert-eql 30f0 (dl:display-list-width list 0))
    (assert-eql 40f0 (dl:display-list-height list 0))
    (assert-eql 0f0 (dl:display-list-radius list 0))
    (assert-eql (red) (dl:display-list-color list 0))
    (assert-eql 4f0 (dl:display-list-radius list 1))
    (assert-eql (blue) (dl:display-list-color list 1))))

(define-test a-full-list-signals-an-error ()
  (let ((list (dl:make-display-list :capacity 2)))
    (dl:push-rect list 0 0 1 1 (red))
    (dl:push-rect list 0 0 1 1 (red))
    (assert-error 'dl:display-list-full (dl:push-rect list 0 0 1 1 (red)))
    (assert-eql 2 (dl:display-list-count list))))

(define-test clearing-makes-room-again ()
  (let ((list (dl:make-display-list :capacity 2)))
    (dl:push-rect list 0 0 1 1 (red))
    (dl:push-rect list 0 0 1 1 (red))
    (dl:clear-display-list list)
    (assert-eql 0 (dl:display-list-count list))
    (dl:push-rect list 9 9 1 1 (blue))
    (assert-eql 9f0 (dl:display-list-x list 0))))

(define-test reading-a-command-that-is-not-there-is-an-error ()
  (let ((list (dl:make-display-list :capacity 4)))
    (dl:push-rect list 0 0 1 1 (red))
    (assert-error 'error (dl:display-list-x list 1))
    (assert-error 'error (dl:display-list-x list -1))))

;;; --- hashing ---

(defun build (&key (x 10) (color (red)) (extra nil))
  (let ((list (dl:make-display-list :capacity 8)))
    (dl:push-rect list x 20 100 50 color)
    (dl:push-rounded-rect list 5 5 10 10 3 (blue))
    (when extra (dl:push-rect list 0 0 1 1 (red)))
    list))

(define-test equal-lists-hash-alike ()
  (assert-eql (dl:display-list-hash (build)) (dl:display-list-hash (build))))

(define-test the-hash-ignores-unused-capacity ()
  (let ((small (dl:make-display-list :capacity 4))
        (large (dl:make-display-list :capacity 400)))
    (dl:push-rect small 1 2 3 4 (red))
    (dl:push-rect large 1 2 3 4 (red))
    (assert-eql (dl:display-list-hash small) (dl:display-list-hash large))))

(define-test any-difference-changes-the-hash ()
  (let ((base (dl:display-list-hash (build))))
    (assert-false (eql base (dl:display-list-hash (build :x 11))))
    (assert-false (eql base (dl:display-list-hash (build :color (blue)))))
    (assert-false (eql base (dl:display-list-hash (build :extra t))))))

(define-test the-kind-of-command-changes-the-hash ()
  (let ((rect (dl:make-display-list :capacity 2))
        (rounded (dl:make-display-list :capacity 2)))
    (dl:push-rect rect 1 2 3 4 (red))
    (dl:push-rounded-rect rounded 1 2 3 4 0 (red))
    (assert-false (eql (dl:display-list-hash rect) (dl:display-list-hash rounded)))))

(define-test a-cleared-list-hashes-like-a-new-one ()
  (let ((used (build))
        (fresh (dl:make-display-list :capacity 8)))
    (dl:clear-display-list used)
    (assert-eql (dl:display-list-hash fresh) (dl:display-list-hash used))))

(define-test the-hash-is-a-fixnum ()
  ;; So that returning it does not allocate.
  (assert-true (typep (dl:display-list-hash (build)) '(unsigned-byte 62)))
  (assert-true (typep (dl:display-list-hash (build)) 'fixnum)))

;;; --- replacing one list with another ---

(defun a-scene (list)
  (dl:push-rect list 1 2 30 40 (red))
  (dl:push-rounded-rect list 5f0 6f0 70f0 80f0 4f0 (blue))
  (dl:push-glyph list 9f0 10f0 11f0 12f0 7 (dl:pack-color 1 2 3 4))
  list)

(defun same-commands-p (a b)
  (and (= (dl:display-list-count a) (dl:display-list-count b))
       (dotimes (i (dl:display-list-count a) t)
         (unless (and (= (dl:display-list-kind a i) (dl:display-list-kind b i))
                      (= (dl:display-list-x a i) (dl:display-list-x b i))
                      (= (dl:display-list-y a i) (dl:display-list-y b i))
                      (= (dl:display-list-width a i) (dl:display-list-width b i))
                      (= (dl:display-list-height a i) (dl:display-list-height b i))
                      (= (dl:display-list-parameter a i) (dl:display-list-parameter b i))
                      (= (dl:display-list-color a i) (dl:display-list-color b i)))
           (return nil)))))

(define-test replacing-a-list-copies-every-field-of-every-command ()
  (let ((source (a-scene (dl:make-display-list :capacity 8)))
        (target (dl:make-display-list :capacity 8)))
    (assert-true (eq target (dl:replace-display-list target source)))
    (assert-eql 3 (dl:display-list-count target))
    (assert-true (same-commands-p source target))
    (assert-eql (dl:display-list-hash source) (dl:display-list-hash target))))

(define-test replacing-a-list-drops-what-the-target-held ()
  (let ((source (dl:make-display-list :capacity 8))
        (target (a-scene (dl:make-display-list :capacity 8))))
    (dl:push-rect source 100 100 5 5 (blue))
    (dl:replace-display-list target source)
    (assert-eql 1 (dl:display-list-count target))
    (assert-eql 100f0 (dl:display-list-x target 0))
    (assert-true (same-commands-p source target))
    ;; And an empty source empties the target.
    (dl:replace-display-list target (dl:make-display-list :capacity 2))
    (assert-eql 0 (dl:display-list-count target))))

(define-test the-source-is-left-alone ()
  (let ((source (a-scene (dl:make-display-list :capacity 8)))
        (target (dl:make-display-list :capacity 8)))
    (let ((hash (dl:display-list-hash source)))
      (dl:replace-display-list target source)
      (dl:clear-display-list target)
      (dl:push-rect target 0 0 1 1 (red))
      (assert-eql 3 (dl:display-list-count source))
      (assert-eql hash (dl:display-list-hash source)))))

(define-test a-target-may-be-larger-than-the-source ()
  (let ((source (a-scene (dl:make-display-list :capacity 4)))
        (target (dl:make-display-list :capacity 100)))
    (dl:replace-display-list target source)
    (assert-true (same-commands-p source target))
    (assert-eql 100 (dl:display-list-capacity target))))

(define-test a-source-too-big-for-the-target-is-an-error-and-changes-nothing ()
  (let ((source (a-scene (dl:make-display-list :capacity 8)))
        (target (dl:make-display-list :capacity 2)))
    (dl:push-rect target 7 7 7 7 (red))
    (assert-error 'dl:display-list-full (dl:replace-display-list target source))
    (assert-eql 1 (dl:display-list-count target))
    (assert-eql 7f0 (dl:display-list-x target 0))))

(define-test replacing-a-list-with-itself-changes-nothing ()
  (let ((list (a-scene (dl:make-display-list :capacity 8))))
    (let ((hash (dl:display-list-hash list)))
      (dl:replace-display-list list list)
      (assert-eql 3 (dl:display-list-count list))
      (assert-eql hash (dl:display-list-hash list)))))

;;; --- appending one list to another, moved ---

(define-test appending-moves-every-kind-of-command-and-keeps-the-rest ()
  (let ((source (a-scene (dl:make-display-list :capacity 8)))
        (target (dl:make-display-list :capacity 8)))
    (dl:push-rect target 0 0 1 1 (red))
    (assert-true (eq target (dl:append-display-list target source 100f0 200f0)))
    (assert-eql 4 (dl:display-list-count target))
    (assert-eql 3 (dl:display-list-count source))
    ;; What was there is untouched, the positions are moved, the rest is copied.
    (assert-eql 0f0 (dl:display-list-x target 0))
    (dotimes (i 3)
      (let ((j (1+ i)))
        (assert-eql (dl:display-list-kind source i) (dl:display-list-kind target j))
        (assert-eql (+ 100f0 (dl:display-list-x source i)) (dl:display-list-x target j))
        (assert-eql (+ 200f0 (dl:display-list-y source i)) (dl:display-list-y target j))
        (assert-eql (dl:display-list-width source i) (dl:display-list-width target j))
        (assert-eql (dl:display-list-height source i) (dl:display-list-height target j))
        (assert-eql (dl:display-list-parameter source i) (dl:display-list-parameter target j))
        (assert-eql (dl:display-list-color source i) (dl:display-list-color target j))))))

(define-test appending-with-no-move-is-plain-appending ()
  (let ((source (a-scene (dl:make-display-list :capacity 8)))
        (target (dl:make-display-list :capacity 8)))
    (dl:append-display-list target source)
    (assert-true (same-commands-p source target))
    (dl:append-display-list target source)
    (assert-eql 6 (dl:display-list-count target))))

(define-test appending-a-list-to-itself-doubles-it ()
  (let ((list (a-scene (dl:make-display-list :capacity 8))))
    (dl:append-display-list list list 10f0 0f0)
    (assert-eql 6 (dl:display-list-count list))
    (assert-eql 1f0 (dl:display-list-x list 0))
    (assert-eql 11f0 (dl:display-list-x list 3))))

(define-test appending-more-than-fits-signals-an-error-and-changes-nothing ()
  (let ((source (a-scene (dl:make-display-list :capacity 8)))
        (target (dl:make-display-list :capacity 3)))
    (dl:push-rect target 7 7 1 1 (red))
    (let ((hash (dl:display-list-hash target)))
      (assert-error 'dl:display-list-full (dl:append-display-list target source 1f0 1f0))
      (assert-eql 1 (dl:display-list-count target))
      (assert-eql hash (dl:display-list-hash target)))
    ;; Exactly enough room is enough.
    (dl:clear-display-list target)
    (dl:append-display-list target source)
    (assert-eql 3 (dl:display-list-count target))))

;;; --- no allocation ---

(defun clear-and-append (target source)
  (dl:clear-display-list target)
  (dl:append-display-list target source 3f0 4f0))

(defun append-many (target source count)
  "Compiled with this file, as REPLACE-MANY is."
  (declare (type fixnum count))
  (dotimes (i count)
    (clear-and-append target source)))

(define-test appending-a-list-does-not-allocate ()
  (let ((source (dl:make-display-list :capacity 1024))
        (target (dl:make-display-list :capacity 1024)))
    (dotimes (i 1000)
      (dl:push-rect source i 0 10 10 (red)))
    (append-many target source 100)
    (let ((before (sb-ext:get-bytes-consed)))
      (append-many target source 20000)
      (assert-true (< (- (sb-ext:get-bytes-consed) before) 500000)))
    (assert-eql 1000 (dl:display-list-count target))
    (assert-eql 3f0 (dl:display-list-x target 0))))

(defun replace-many (target source count)
  "Compiled with this file, because lisp-unit2 evaluates test bodies under a
debugging policy that allocates."
  (declare (type fixnum count))
  (dotimes (i count)
    (dl:replace-display-list target source)))

(define-test replacing-a-list-does-not-allocate ()
  (let ((source (dl:make-display-list :capacity 1024))
        (target (dl:make-display-list :capacity 1024)))
    (dotimes (i 1000)
      (dl:push-rect source i 0 10 10 (red)))
    (replace-many target source 100)                ; warm up
    (let ((before (sb-ext:get-bytes-consed)))
      (replace-many target source 20000)
      ;; 20 million commands copied.
      (assert-true (< (- (sb-ext:get-bytes-consed) before) 500000)))
    (assert-true (same-commands-p source target))))

(define-test building-and-hashing-a-frame-does-not-allocate ()
  (let ((list (dl:make-display-list :capacity 128))
        (sum 0)
        (before (sb-ext:get-bytes-consed)))
    (declare (type (unsigned-byte 62) sum))
    (dotimes (frame 20000)
      (dl:clear-display-list list)
      (dotimes (i 50)
        (dl:push-rect list i 0 10 10 #xFF0000FF)
        (dl:push-rounded-rect list i 1 10 10 2 #x00FF00FF))
      (setf sum (ldb (byte 62 0) (+ sum (dl:display-list-hash list)))))
    (assert-true (plusp sum))
    ;; Two million commands. One byte per command would already be 2 MB.
    (let ((delta (- (sb-ext:get-bytes-consed) before)))
      (assert-true (< delta 1000000) delta))))
