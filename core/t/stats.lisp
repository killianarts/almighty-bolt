(defpackage #:almighty-bolt-core/t/stats
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:stats #:almighty-bolt-core/stats)))

(in-package #:almighty-bolt-core/t/stats)

(define-test the-median-is-the-middle-sample-or-the-mean-of-the-two-middle-ones ()
  (assert-eql 3 (stats:median '(5 1 3)))
  (assert-eql 5/2 (stats:median '(4 1 3 2)))
  (assert-eql 7 (stats:median #(7)))
  (assert-false (stats:median '())))

(define-test a-percentile-is-always-one-of-the-samples ()
  (let ((samples (loop :for i :from 1 :to 100 :collect i)))
    (assert-eql 50 (stats:percentile samples 0.5))
    (assert-eql 95 (stats:percentile samples 0.95))
    (assert-eql 99 (stats:percentile samples 0.99))
    (assert-eql 100 (stats:percentile samples 1))
    (assert-eql 1 (stats:percentile samples 0)))
  (assert-eql 9 (stats:percentile '(9) 0.99))
  (assert-false (stats:percentile '() 0.5)))

(define-test a-summary-has-the-count-and-the-order-statistics ()
  (let ((summary (stats:summarize '(10 30 20 40))))
    (assert-eql 4 (getf summary :n))
    (assert-eql 10 (getf summary :min))
    (assert-eql 25 (getf summary :median))
    (assert-eql 40 (getf summary :p95))
    (assert-eql 40 (getf summary :max))
    (assert-eql 25 (getf summary :mean)))
  (assert-false (stats:summarize '())))
