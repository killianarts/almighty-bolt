(defpackage #:almighty-bolt-core/t/ring
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:ring #:almighty-bolt-core/ring)
                    (#:clock #:almighty-bolt-core/clock)))

(in-package #:almighty-bolt-core/t/ring)

(defvar *sink* nil
  "Keeps allocations in tests from being optimized away.")

(defun collect-frames (frame-ring)
  (let ((frames '()))
    (ring:map-frames (lambda (start end before after)
                       (push (list start end before after) frames))
                     frame-ring)
    (nreverse frames)))

;;; --- recording ---

(define-test an-empty-ring-holds-nothing ()
  (let ((frame-ring (ring:make-frame-ring :capacity 4)))
    (assert-eql 4 (ring:frame-ring-capacity frame-ring))
    (assert-eql 0 (ring:frame-ring-count frame-ring))
    (assert-eql 0 (ring:frame-ring-total frame-ring))
    (assert-equal '() (collect-frames frame-ring))))

(define-test records-come-back-oldest-first ()
  (let ((frame-ring (ring:make-frame-ring :capacity 4)))
    (ring:record-frame frame-ring 10 20 100 150)
    (ring:record-frame frame-ring 30 45 150 150)
    (assert-eql 2 (ring:frame-ring-count frame-ring))
    (assert-equal '((10 20 100 150) (30 45 150 150)) (collect-frames frame-ring))
    (assert-eql 10 (ring:frame-start-ns frame-ring 0))
    (assert-eql 45 (ring:frame-end-ns frame-ring 1))
    (assert-eql 10 (ring:frame-duration-ns frame-ring 0))
    (assert-eql 15 (ring:frame-duration-ns frame-ring 1))
    (assert-eql 50 (ring:frame-bytes-consed frame-ring 0))
    (assert-eql 0 (ring:frame-bytes-consed frame-ring 1))
    (assert-eql 100 (ring:frame-bytes-consed-before frame-ring 0))
    (assert-eql 150 (ring:frame-bytes-consed-after frame-ring 0))))

(define-test a-full-ring-overwrites-the-oldest-record ()
  (let ((frame-ring (ring:make-frame-ring :capacity 3)))
    (dotimes (i 5)
      (ring:record-frame frame-ring i (+ i 1) 0 0))
    (assert-eql 3 (ring:frame-ring-count frame-ring))
    (assert-eql 5 (ring:frame-ring-total frame-ring))
    (assert-equal '((2 3 0 0) (3 4 0 0) (4 5 0 0)) (collect-frames frame-ring))))

(define-test clearing-forgets-records ()
  (let ((frame-ring (ring:make-frame-ring :capacity 3)))
    (dotimes (i 5)
      (ring:record-frame frame-ring i i 0 0))
    (ring:clear-frame-ring frame-ring)
    (assert-eql 0 (ring:frame-ring-count frame-ring))
    (assert-eql 0 (ring:frame-ring-total frame-ring))
    (ring:record-frame frame-ring 7 8 0 0)
    (assert-equal '((7 8 0 0)) (collect-frames frame-ring))))

(define-test reading-a-missing-record-is-an-error ()
  (let ((frame-ring (ring:make-frame-ring :capacity 3)))
    (ring:record-frame frame-ring 1 2 0 0)
    (assert-error 'error (ring:frame-start-ns frame-ring 1))
    (assert-error 'error (ring:frame-start-ns frame-ring -1))))

(define-test the-capacity-must-be-positive ()
  (assert-error 'type-error (ring:make-frame-ring :capacity 0)))

;;; --- the phases of a frame ---

(define-test a-record-without-phases-reads-them-as-zero ()
  (let ((frame-ring (ring:make-frame-ring :capacity 4)))
    (ring:record-frame frame-ring 10 20 100 150)
    (assert-eql 0 (ring:frame-build-ns frame-ring 0))
    (assert-eql 0 (ring:frame-drawable-wait-ns frame-ring 0))
    (assert-eql 0 (ring:frame-encode-ns frame-ring 0))
    (assert-eql 0 (ring:frame-builds frame-ring 0))
    (assert-false (ring:frame-capped-p frame-ring 0))))

(define-test the-phases-come-back-with-the-record ()
  (let ((frame-ring (ring:make-frame-ring :capacity 4)))
    (ring:record-frame frame-ring 10 90 100 150 40 30 10 2 nil)
    (ring:record-frame frame-ring 100 190 150 150 50 25 15 3 t)
    (assert-eql 40 (ring:frame-build-ns frame-ring 0))
    (assert-eql 30 (ring:frame-drawable-wait-ns frame-ring 0))
    (assert-eql 10 (ring:frame-encode-ns frame-ring 0))
    (assert-eql 2 (ring:frame-builds frame-ring 0))
    (assert-false (ring:frame-capped-p frame-ring 0))
    (assert-eql 50 (ring:frame-build-ns frame-ring 1))
    (assert-eql 25 (ring:frame-drawable-wait-ns frame-ring 1))
    (assert-eql 15 (ring:frame-encode-ns frame-ring 1))
    (assert-eql 3 (ring:frame-builds frame-ring 1))
    (assert-true (ring:frame-capped-p frame-ring 1))
    ;; The four words of the old record are unchanged.
    (assert-equal '((10 90 100 150) (100 190 150 150)) (collect-frames frame-ring))))

(define-test the-build-count-and-the-cap-flag-do-not-disturb-each-other ()
  (let ((frame-ring (ring:make-frame-ring :capacity 4)))
    (ring:record-frame frame-ring 0 1 0 0 0 0 0 (1- (expt 2 32)) nil)
    (ring:record-frame frame-ring 0 1 0 0 0 0 0 (1- (expt 2 32)) t)
    (ring:record-frame frame-ring 0 1 0 0 0 0 0 0 t)
    (assert-eql (1- (expt 2 32)) (ring:frame-builds frame-ring 0))
    (assert-false (ring:frame-capped-p frame-ring 0))
    (assert-eql (1- (expt 2 32)) (ring:frame-builds frame-ring 1))
    (assert-true (ring:frame-capped-p frame-ring 1))
    (assert-eql 0 (ring:frame-builds frame-ring 2))
    (assert-true (ring:frame-capped-p frame-ring 2))))

(define-test an-overwritten-record-takes-its-phases-with-it ()
  (let ((frame-ring (ring:make-frame-ring :capacity 2)))
    (ring:record-frame frame-ring 1 2 0 0 11 12 13 1 nil)
    (ring:record-frame frame-ring 3 4 0 0 21 22 23 2 nil)
    (ring:record-frame frame-ring 5 6 0 0 31 32 33 3 t)
    (assert-eql 2 (ring:frame-ring-count frame-ring))
    (assert-eql 21 (ring:frame-build-ns frame-ring 0))
    (assert-eql 31 (ring:frame-build-ns frame-ring 1))
    (assert-eql 33 (ring:frame-encode-ns frame-ring 1))
    (assert-true (ring:frame-capped-p frame-ring 1))))

;;; --- recording a frame around code ---

(define-test with-recorded-frame-times-and-counts-the-body ()
  (let ((frame-ring (ring:make-frame-ring :capacity 4)))
    (ring:with-recorded-frame (frame-ring)
      (sleep 0.02)
      ;; Large objects are charged as soon as they are allocated.
      (setf *sink* (make-array 200000 :element-type '(unsigned-byte 64))))
    (assert-eql 1 (ring:frame-ring-count frame-ring))
    (assert-true (>= (ring:frame-duration-ns frame-ring 0) 18000000))
    (assert-true (>= (ring:frame-bytes-consed frame-ring 0) 1600000))))

(define-test with-recorded-frame-returns-the-values-of-the-body ()
  (let ((frame-ring (ring:make-frame-ring :capacity 2)))
    (assert-equal '(1 2 3)
                  (multiple-value-list
                   (ring:with-recorded-frame (frame-ring) (values 1 2 3))))))

(define-test with-recorded-frame-uses-the-core-clock ()
  (let ((frame-ring (ring:make-frame-ring :capacity 2))
        (virtual (clock:make-virtual-clock 5000)))
    (clock:with-time-source ((clock:virtual-clock-source virtual))
      (ring:with-recorded-frame (frame-ring)
        (clock:advance-virtual-clock virtual 250)))
    (assert-eql 5000 (ring:frame-start-ns frame-ring 0))
    (assert-eql 5250 (ring:frame-end-ns frame-ring 0))))

;;; --- no allocation ---

(define-test recording-phases-does-not-allocate ()
  (let ((frame-ring (ring:make-frame-ring :capacity 1024))
        (before (sb-ext:get-bytes-consed)))
    (dotimes (i 500000)
      (ring:record-frame frame-ring i (+ i 100) 100 200 40 30 10 2 (evenp i)))
    (assert-true (< (- (sb-ext:get-bytes-consed) before) 1000000))))

(define-test recording-does-not-allocate ()
  (let ((frame-ring (ring:make-frame-ring :capacity 1024))
        (before (sb-ext:get-bytes-consed)))
    (dotimes (i 500000)
      (ring:record-frame frame-ring i (+ i 10) 100 200))
    (assert-true (< (- (sb-ext:get-bytes-consed) before) 1000000))))

(define-test with-recorded-frame-does-not-allocate ()
  (let ((frame-ring (ring:make-frame-ring :capacity 1024))
        (before (sb-ext:get-bytes-consed)))
    (dotimes (i 200000)
      (ring:with-recorded-frame (frame-ring)
        nil))
    (assert-true (< (- (sb-ext:get-bytes-consed) before) 1000000))))

;;; --- the details of Phase 3 ---

(define-test the-details-come-back-with-the-record-and-leave-the-rest ()
  (let ((frame-ring (ring:make-frame-ring :capacity 4)))
    (ring:record-frame frame-ring 10 90 100 150 40 30 10 2 nil)
    (ring:record-frame-details frame-ring :gc-ns 5 :first-build-ns 25 :update-ns 3
                                          :layout-ns 11 :paint-ns 7 :gpu-ns 900
                                          :all-builds-ns 38)
    (assert-eql 5 (ring:frame-gc-ns frame-ring 0))
    (assert-eql 25 (ring:frame-first-build-ns frame-ring 0))
    (assert-eql 3 (ring:frame-update-ns frame-ring 0))
    (assert-eql 11 (ring:frame-layout-ns frame-ring 0))
    (assert-eql 7 (ring:frame-paint-ns frame-ring 0))
    (assert-eql 900 (ring:frame-gpu-ns frame-ring 0))
    (assert-eql 38 (ring:frame-all-builds-ns frame-ring 0))
    (assert-eql 40 (ring:frame-build-ns frame-ring 0))
    (assert-eql 2 (ring:frame-builds frame-ring 0))))

(define-test the-details-go-with-the-last-record-even-when-the-ring-has-wrapped ()
  (let ((frame-ring (ring:make-frame-ring :capacity 2)))
    (dotimes (i 3)
      (ring:record-frame frame-ring i (1+ i) 0 0)
      (ring:record-frame-details frame-ring :layout-ns (* 100 (1+ i))))
    (assert-eql 200 (ring:frame-layout-ns frame-ring 0))
    (assert-eql 300 (ring:frame-layout-ns frame-ring 1))))

(define-test a-record-without-details-has-none-even-over-an-older-one ()
  (let ((frame-ring (ring:make-frame-ring :capacity 1)))
    (ring:record-frame frame-ring 1 2 0 0)
    (ring:record-frame-details frame-ring :gc-ns 9 :paint-ns 9 :gpu-ns 9)
    (ring:record-frame frame-ring 3 4 0 0)
    (assert-eql 0 (ring:frame-gc-ns frame-ring 0))
    (assert-eql 0 (ring:frame-paint-ns frame-ring 0))
    (assert-eql 0 (ring:frame-gpu-ns frame-ring 0))))

(define-test recording-details-does-not-allocate ()
  (let ((frame-ring (ring:make-frame-ring :capacity 1024))
        (before (sb-ext:get-bytes-consed)))
    (dotimes (i 500000)
      (ring:record-frame frame-ring i (+ i 100) 100 200 40 30 10 2 nil)
      (ring:record-frame-details frame-ring :gc-ns i :first-build-ns 3 :layout-ns 4 :paint-ns 5))
    (assert-true (< (- (sb-ext:get-bytes-consed) before) 1000000))))

