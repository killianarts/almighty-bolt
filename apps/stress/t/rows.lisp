(defpackage #:almighty-bolt-stress/t/rows
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:m #:almighty-bolt-stress/rows/model)
                    (#:p #:almighty-bolt-stress/rows/paint)
                    (#:fake #:almighty-bolt-variant-support/fake-context)
                    (#:core #:almighty-bolt-core)))

(in-package #:almighty-bolt-stress/t/rows)

;;; The million-row list's numbers: where the list is scrolled to, the thumb, the keys, what a row
;;; shows, and the painter (with the context whose text is 8 points a character).

(define-test the-first-row-is-kept-inside-the-list ()
  (assert-eql 0 (m:clamp-top -5))
  (assert-eql 0 (m:clamp-top 0))
  (assert-eql 500 (m:clamp-top 500))
  (assert-eql (- m:+row-count+ m:+visible-rows+) (m:clamp-top m:+row-count+))
  (assert-eql (- m:+row-count+ m:+visible-rows+) (m:clamp-top (- m:+row-count+ m:+visible-rows+))))

(define-test a-point-is-in-a-row-or-the-bar-or-outside ()
  (assert-eql 0 (m:row-at 10 0 0))
  (assert-eql 0 (m:row-at 10 21 0))
  (assert-eql 1 (m:row-at 10 22 0))
  (assert-eql 17 (m:row-at 10 395 0))
  (assert-eql 1017 (m:row-at 10 395 1000))
  (assert-false (m:row-at 10 396 0))
  (assert-false (m:row-at -1 10 0))
  (assert-false (m:row-at 590 10 0))
  (assert-true (m:on-bar-p 590))
  (assert-false (m:on-bar-p 585)))

(define-test the-thumb-is-at-the-top-for-the-first-row-and-at-the-bottom-for-the-last ()
  (assert-true (< (abs (m:thumb-top 0)) 1e-4))
  (assert-true (< (abs (- (m:thumb-top (- m:+row-count+ m:+visible-rows+))
                          (- m:+list-height+ m:+thumb-height+)))
                  1e-2)))

(define-test dragging-the-thumb-to-a-place-gives-the-row-the-thumb-is-at ()
  (assert-eql 0 (m:top-for-thumb 0))
  (assert-eql (- m:+row-count+ m:+visible-rows+) (m:top-for-thumb m:+list-height+))
  (let ((top (m:top-for-thumb (+ (m:thumb-top 250000) (/ m:+thumb-height+ 2)))))
    (assert-true (< (abs (- top 250000)) 3000))))

(define-test the-keys-move-the-selected-row-and-scroll-just-far-enough ()
  (flet ((move (key selected top)
           (multiple-value-list (m:key-move key selected top))))
    (assert-equal '(1 0 t) (move core:+key-down+ 0 0))
    (assert-equal '(1 0 t) (move core:+key-down+ nil 0))
    (assert-equal '(0 0 t) (move core:+key-up+ 0 0))
    (assert-equal '(18 1 t) (move core:+key-down+ 17 0))
    (assert-equal '(4 4 t) (move core:+key-up+ 5 5))
    (assert-equal '(18 1 t) (move core:+key-page-down+ 0 0))
    (assert-equal '(0 0 t) (move core:+key-page-up+ 5 0))
    (assert-equal '(0 0 t) (move core:+key-home+ 900 800))
    (assert-equal (list (1- m:+row-count+) (- m:+row-count+ m:+visible-rows+) t)
                  (move core:+key-end+ 0 0))
    (assert-equal '(7 3 nil) (move #\x 7 3))))

(define-test what-a-row-shows ()
  (assert-equal "Row 0000001" (m:row-id-text 0))
  (assert-equal "Row 1000000" (m:row-id-text 999999))
  (assert-eq (m:row-id-text 123) (m:row-id-text 123))
  (assert-equal "Row 0000124" (m:row-id-text 123))
  (assert-equal (m:row-name-text 5) (m:row-name-text 5))
  (assert-true (find #\Space (m:row-name-text 5)))
  (assert-true (find #\. (m:row-value-text 5))))

(define-test the-status-says-which-row-is-selected-of-how-many ()
  (assert-equal "No row selected" (m:status-text nil))
  (assert-true (search "Row 1 of 1,000,000 selected" (m:status-text 0)))
  (assert-true (search "Row 1,000,000 of 1,000,000 selected" (m:status-text 999999))))

(defun paint (top selected)
  (let ((context (fake:make-fake-context :width 640f0 :height 470f0))
        (list (core:make-display-list :capacity 4096)))
    (p:paint-rows context list 0f0 0f0 600f0 396f0 top selected)
    list))

(define-test the-list-draws-a-ground-the-visible-rows-and-the-bar ()
  (let* ((list (paint 0 nil))
         (glyphs (loop :for i :below (core:display-list-count list)
                       :count (= (core:display-list-kind list i) core:+command-glyph+)))
         (expected (loop :for index :below m:+visible-rows+
                         :sum (+ (length (m:row-id-text index)) (length (m:row-name-text index))
                                 (length (m:row-value-text index))))))
    (assert-eql expected glyphs)))

(define-test the-selected-row-has-its-own-colour-and-only-if-it-shows ()
  (flet ((colors (list)
           (loop :for i :below (core:display-list-count list)
                 :when (= (core:display-list-kind list i) core:+command-rect+)
                   :collect (core:display-list-color list i))))
    (let ((plain (colors (paint 0 nil)))
          (selected (colors (paint 0 3)))
          (hidden (colors (paint 0 500))))
      (assert-false (equal plain selected))
      (assert-equal plain hidden))))

(define-test the-last-rows-are-drawn-and-nothing-past-them ()
  (let* ((top (- m:+row-count+ m:+visible-rows+))
         (list (paint top nil))
         (text (with-output-to-string (stream)
                 (dotimes (i (core:display-list-count list))
                   (when (= (core:display-list-kind list i) core:+command-glyph+)
                     (write-char (code-char (round (core:display-list-parameter list i))) stream))))))
    (assert-true (search "Row 1000000" text))
    (assert-false (search "Row 1000001" text))))

(define-test painting-the-same-rows-again-allocates-little ()
  (let ((context (fake:make-fake-context :width 640f0 :height 470f0))
        (list (core:make-display-list :capacity 4096)))
    (p:paint-rows context list 0f0 0f0 600f0 396f0 1000 5)
    (let ((before (sb-ext:get-bytes-consed)))
      (dotimes (i 2000)
        (core:clear-display-list list)
        (p:paint-rows context list 0f0 0f0 600f0 396f0 1000 5))
      ;; The fake context's own text lists are what is left.
      (assert-true (< (- (sb-ext:get-bytes-consed) before) 20000000)))))
