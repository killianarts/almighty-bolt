(defpackage #:almighty-bolt-7guis/cells/app
  (:use #:cl)
  (:local-nicknames (#:bolt #:almighty-bolt)
                    (#:registry #:almighty-bolt-7guis/common/registry)
                    (#:model #:almighty-bolt-7guis/cells/model)
                    (#:g #:almighty-bolt-7guis/cells/geometry)
                    (#:paint #:almighty-bolt-7guis/cells/paint))
  (:export #:make-cells))

(in-package #:almighty-bolt-7guis/cells/app)

;;; The cells task, immediate: the sheet is a mutable object, and which cell is selected,
;;; where the grid is scrolled to and what is being typed are variables. The grid is drawn by
;;; a function that reads them, every frame, and the events on it are handled in the loop
;;; that follows.

(defun make-cells ()
  (bolt:state-let ((sheet (model:make-sheet))
                   (selected-column 0)
                   (selected-row 0)
                   (first-column 0)
                   (first-row 0)
                   (editing nil)
                   (remainder-x 0f0)
                   (remainder-y 0f0))
    (labels ((commit ()
               (when editing
                 (model:sheet-set sheet selected-column selected-row (bolt:text-state-string editing))
                 (setf editing nil)))
             (select (new-column new-row)
               (commit)
               (let ((new-column (max 0 (min (1- model:+columns+) new-column)))
                     (new-row (max 0 (min (1- model:+rows+) new-row))))
                 (setf selected-column new-column
                       selected-row new-row)
                 (cond ((< new-column first-column)
                        (setf first-column new-column))
                       ((>= new-column (+ first-column g:+visible-columns+))
                        (setf first-column (1+ (- new-column g:+visible-columns+)))))
                 (cond ((< new-row first-row)
                        (setf first-row new-row))
                       ((>= new-row (+ first-row g:+visible-rows+))
                        (setf first-row (1+ (- new-row g:+visible-rows+)))))))
             (press (x y button click-count)
               (when (eql button 0)
                 (multiple-value-bind (new-column new-row) (g:cell-at x y first-column first-row)
                   (when (and new-column (< new-column model:+columns+) (< new-row model:+rows+))
                     (select new-column new-row)
                     ;; A double click edits what the cell holds.
                     (when (>= click-count 2)
                       (setf editing (bolt:make-text-state (model:sheet-text sheet new-column new-row))))))))
             (scroll (dx dy)
               (incf remainder-x (- (* dx g:+columns-per-line+)))
               (incf remainder-y (- dy))
               (let ((columns (truncate remainder-x))
                     (rows (truncate remainder-y)))
                 (decf remainder-x columns)
                 (decf remainder-y rows)
                 (setf first-column (g:clamp-first (+ first-column columns) model:+columns+
                                                   g:+visible-columns+)
                       first-row (g:clamp-first (+ first-row rows) model:+rows+ g:+visible-rows+))))
             (key (event)
               (when (eq (bolt:key-event-kind event) :down)
                 (let ((key (bolt:key-event-logical-key event))
                       (modifiers (bolt:key-event-modifiers event)))
                   (cond
                     (editing
                      (cond ((eql key #\Return) (select selected-column (1+ selected-row)))
                            ((eql key #\Escape) (setf editing nil))
                            (t (multiple-value-bind (new edited) (bolt:edit-text editing event)
                                 (when edited
                                   (setf editing new))))))
                     ((eql key bolt:+key-up+) (select selected-column (1- selected-row)))
                     ((eql key bolt:+key-down+) (select selected-column (1+ selected-row)))
                     ((eql key bolt:+key-left+) (select (1- selected-column) selected-row))
                     ((eql key bolt:+key-right+) (select (1+ selected-column) selected-row))
                     ((eql key #\Return)
                      (setf editing (bolt:make-text-state (model:sheet-text sheet selected-column
                                                                            selected-row))))
                     ((or (eql key #\Backspace) (eql key bolt:+key-delete-forward+))
                      (model:sheet-set sheet selected-column selected-row ""))
                     ((or (bolt:modifier-down-p modifiers bolt:+modifier-super+)
                          (bolt:modifier-down-p modifiers bolt:+modifier-control+))
                      nil)
                     (t (multiple-value-bind (new edited) (bolt:edit-text (bolt:make-text-state "") event)
                          (when edited
                            (setf editing new))))))))
             (draw (list context width height)
               (paint:paint-grid context list 0f0 0f0 width height sheet selected-column selected-row
                                 first-column first-row editing)))
      (lambda ()
        (bolt:padding (:all 20)
          (bolt:column (:gap 12)
            (bolt:row (:gap 10 :cross-align :center)
              (bolt:label "Cell:" :id :cell-label)
              (bolt:label (model:format-ref selected-column selected-row) :id :cell-name)
              (bolt:label "Contents:" :id :contents-label)
              (bolt:label (if editing
                              (bolt:text-state-string editing)
                              (model:sheet-text sheet selected-column selected-row))
                          :id :formula))
            (dolist (event (bolt:canvas g:+grid-width+ g:+grid-height+ #'draw :id :grid :focusable t))
              (ecase (first event)
                (:press (press (second event) (third event) (fourth event) (fifth event)))
                (:key (key (second event)))
                (:wheel (scroll (second event) (third event)))
                ((:move :drag :release :exit) nil)))))))))

(registry:register-app :cells 'make-cells :width 640 :height 440)
