(:almighty-bolt-replay 1 :variant :immediate :app :timer :width 460 :height 250)
(0 (:pointer :kind :move :target :reset :fx 0.5d0 :fy 0.5d0))
(1000000 (:pointer :kind :down :target :reset :fx 0.5d0 :fy 0.5d0 :button 0 :buttons 1 :click-count 1))
(2000000 (:pointer :kind :up :target :reset :fx 0.5d0 :fy 0.5d0 :button 0 :click-count 1))
(1000000000 (:checkpoint :name "after one second"))
(3000000000 (:checkpoint :name "after three seconds"))
(3500000000 (:pointer :kind :move :target :reset :fx 0.5d0 :fy 0.5d0))
(3501000000 (:pointer :kind :down :target :reset :fx 0.5d0 :fy 0.5d0 :button 0 :buttons 1 :click-count 1))
(3502000000 (:pointer :kind :up :target :reset :fx 0.5d0 :fy 0.5d0 :button 0 :click-count 1))
(4000000000 (:checkpoint :name "half a second after the reset"))
