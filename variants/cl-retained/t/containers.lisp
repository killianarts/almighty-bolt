(defpackage #:almighty-bolt-variant-retained/t/containers
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:w #:almighty-bolt-variant-retained/widgets)
                    (#:n #:almighty-bolt-variant-retained/node)
                    (#:retained #:almighty-bolt-variant-retained/retained)
                    (#:fake #:almighty-bolt-variant-support/fake-context)
                    (#:core #:almighty-bolt-core)))

(in-package #:almighty-bolt-variant-retained/t/containers)

;;; Stacks, panels, centring, gauges, hiding, disabling and tickers, with a context whose
;;; text is 8 points a character, 10 above the baseline and 4 below.

(defvar *context* nil)

(defun lay-out (root &key (width 400f0) (height 300f0))
  (setf *context* (fake:make-fake-context :width width :height height))
  (n:layout-node root *context* 0f0 width 0f0 height)
  root)

(defun geometry (node)
  (list (n:node-x node) (n:node-y node) (n:node-w node) (n:node-h node)))

(defun show (root)
  (setf *context* (fake:make-fake-context))
  (let ((variant (retained:make-retained-variant root)))
    (core:frame variant *context* (core:make-display-list :capacity 512))
    variant))

(defun build (variant)
  (let ((list (core:make-display-list :capacity 512)))
    (core:frame variant *context* list)
    list))

(defun pointer (variant kind x y &key (button nil) (buttons 0))
  (core:handle-event variant (core:make-pointer-event :timestamp 0 :kind kind :x (float x 1d0)
                                                      :y (float y 1d0) :button button
                                                      :buttons buttons)))

(define-test a-stack-is-as-large-as-its-largest-child-and-puts-them-all-at-its-corner ()
  (let* ((small (w:label "ab"))
         (large (w:label "abcdef"))
         (stack (w:stack small large)))
    (lay-out stack)
    (assert-equal '(0f0 0f0 48f0 14f0) (geometry stack))
    (assert-equal '(0f0 0f0 16f0 14f0) (geometry small))
    (assert-equal '(0f0 0f0 48f0 14f0) (geometry large))
    ;; The later child is on top, so it is the one found under a point.
    (assert-true (eq large (n:node-at stack 5f0 5f0)))))

(define-test a-panel-is-its-child-and-its-padding-on-a-background ()
  (let* ((label (w:label "ab"))
         (panel (w:panel label :all 6)))
    (lay-out panel)
    (assert-equal '(0f0 0f0 28f0 26f0) (geometry panel))
    (assert-equal '(6f0 6f0 16f0 14f0) (geometry label))
    (let ((list (core:make-display-list :capacity 16)))
      (n:paint-node panel *context* list 0f0 0f0)
      (assert-eql core:+command-rounded-rect+ (core:display-list-kind list 0))
      (assert-eql 28f0 (core:display-list-width list 0)))))

(define-test centring-puts-the-child-in-the-middle-of-the-room ()
  (let* ((label (w:label "ab"))
         (center (w:center label)))
    (lay-out center :width 100f0 :height 60f0)
    (assert-equal '(0f0 0f0 100f0 60f0) (geometry center))
    (assert-equal '(42f0 23f0 16f0 14f0) (geometry label))))

(define-test a-gauge-is-as-full-as-its-fraction ()
  (let ((progress (w:progress :fraction 0.25 :width 100)))
    (lay-out progress)
    (assert-equal '(0f0 0f0 100f0 14f0) (geometry progress))
    (let ((list (core:make-display-list :capacity 16)))
      (n:paint-node progress *context* list 0f0 0f0)
      (assert-eql 2 (core:display-list-count list))
      (assert-eql 25f0 (core:display-list-width list 1)))
    (setf (w:progress-fraction progress) 5)
    (assert-eql 1d0 (w:progress-fraction progress))
    (setf (w:progress-fraction progress) 0)
    (let ((list (core:make-display-list :capacity 16)))
      (n:paint-node progress *context* list 0f0 0f0)
      (assert-eql 1 (core:display-list-count list)))))

;;; --- hiding and disabling ---

(define-test a-hidden-node-takes-no-room-draws-nothing-and-is-not-found ()
  (let* ((a (w:label "ab"))
         (b (w:label "cdef"))
         (c (w:label "gh"))
         (row (w:row a b c :gap 4)))
    (lay-out row)
    (assert-eql 72f0 (n:node-w row))
    (setf (n:node-visible b) nil)
    (lay-out row)
    ;; Two labels and one gap: the hidden one's gap is there, as the row does not know.
    (assert-eql 40f0 (n:node-w row))
    (assert-false (n:node-at b 2f0 2f0))
    (let ((list (core:make-display-list :capacity 16)))
      (n:paint-node row *context* list 0f0 0f0)
      (assert-eql 4 (core:display-list-count list)))
    (setf (n:node-visible b) t)
    (lay-out row)
    (assert-eql 72f0 (n:node-w row))))

(define-test hiding-a-node-marks-the-tree-for-layout-and-a-frame ()
  (let* ((label (w:label "ab"))
         (variant (show (w:column label))))
    (build variant)
    (setf (n:node-visible label) nil)
    ;; The change is seen by the next event that reports changes, and by the next frame.
    (let ((list (build variant)))
      (assert-eql 1 (core:display-list-count list)))))

(define-test a-disabled-button-is-dimmed-takes-no-click-and-is-skipped-by-tab ()
  (let* ((clicks 0)
         (one (w:button "One" :id :one :on-click (lambda () (incf clicks))))
         (two (w:button "Two" :id :two :on-click (lambda () (incf clicks 10))))
         (variant (show (w:row one two :gap 8))))
    (setf (n:node-enabled one) nil)
    (build variant)
    (assert-eql :disabled (w:button-state one))
    (pointer variant :down 20 10 :button 0 :buttons 1)
    (pointer variant :up 20 10 :button 0)
    (assert-eql 0 clicks)
    (core:handle-event variant (core:make-key-event :timestamp 0 :kind :down :logical-key #\Tab))
    (assert-true (eq two (retained:retained-variant-focus variant)))
    (setf (n:node-enabled one) t)
    (build variant)
    (assert-eql :normal (w:button-state one))
    (pointer variant :down 20 10 :button 0 :buttons 1)
    (pointer variant :up 20 10 :button 0)
    (assert-eql 1 clicks)))

;;; --- a scrim ---

(define-test a-scrim-fills-the-room-and-takes-the-pointer-from-what-is-under-it ()
  (let* ((clicks 0)
         (closed 0)
         (button (w:button "Go" :id :go :on-click (lambda () (incf clicks))))
         (scrim (w:scrim :id :scrim :on-press (lambda () (incf closed))))
         (variant (show (w:stack (w:column button) scrim))))
    (build variant)
    (assert-equal '(0f0 0f0 400f0 300f0) (geometry scrim))
    ;; The button is under the scrim now, and a press over it is the scrim's.
    (assert-eql :scrim (core:hit-target variant 10f0 10f0))
    (pointer variant :down 10 10 :button 0 :buttons 1)
    (pointer variant :up 10 10 :button 0)
    (assert-eql 0 clicks)
    (assert-eql 1 closed)
    (setf (n:node-visible scrim) nil)
    (build variant)
    (pointer variant :down 10 10 :button 0 :buttons 1)
    (pointer variant :up 10 10 :button 0)
    (assert-eql 1 clicks)))

;;; --- tickers ---

(define-test a-ticker-runs-every-frame-and-keeps-frames-coming-while-it-says-so ()
  (let* ((label (w:label "0"))
         (variant (show (w:column label)))
         (ticks 0)
         (times '()))
    (retained:add-ticker variant (lambda (now)
                                   (push now times)
                                   (incf ticks)
                                   (setf (w:label-text label) (princ-to-string ticks))
                                   (< ticks 3)))
    (core:take-frame-request *context*)
    (build variant)
    (assert-eql 1 ticks)
    (assert-equal "1" (w:label-text label))
    (assert-true (core:take-frame-request *context*))
    (build variant)
    (assert-true (core:take-frame-request *context*))
    (build variant)
    ;; The third tick said it was done, so no frame is asked for.
    (assert-false (core:take-frame-request *context*))
    (assert-eql 3 ticks)
    (assert-true (apply #'>= times))))
