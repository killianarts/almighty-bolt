(defpackage #:almighty-bolt-variant-reactive/t/builder
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:b #:almighty-bolt-variant-reactive/builder)
                    (#:v #:almighty-bolt-variant-reactive/views)))

(in-package #:almighty-bolt-variant-reactive/t/builder)

;;; The views written with the options first and the children as the body, against the functions
;;; they expand into: a view is a value, so the two are the same when they are EQUALP.

(define-test a-column-is-the-same-as-the-column-function ()
  (assert-equalp (v:column (v:label "one") (v:label "two") :gap 10 :cross-align :center :id :c)
                 (b:column (:gap 10 :cross-align :center :id :c)
                   (v:label "one") (v:label "two"))))

(define-test a-row-and-a-stack-are-the-same-as-their-functions ()
  (assert-equalp (v:row (v:label "a") :gap 3 :flex 1 :fill t)
                 (b:row (:gap 3 :flex 1 :fill t) (v:label "a")))
  (assert-equalp (v:stack (v:label "a") (v:label "b") :id :layers)
                 (b:stack (:id :layers) (v:label "a") (v:label "b"))))

(define-test padding-panel-and-center-are-the-same-as-their-functions ()
  (assert-equalp (v:padding (v:label "a") :all 10 :left 3)
                 (b:padding (:all 10 :left 3) (v:label "a")))
  (assert-equalp (v:panel (v:label "a") :all 6 :radius 4 :key 2)
                 (b:panel (:all 6 :radius 4 :key 2) (v:label "a")))
  (assert-equalp (v:center (v:label "a"))
                 (b:center () (v:label "a"))))

(define-test the-children-are-the-values-in-order-a-list-is-put-in-and-a-nil-is-left-out ()
  (let ((column (b:column ()
                  (v:label "a")
                  (loop :for i :below 3 :collect (v:label (princ-to-string i)))
                  (when nil (v:label "never"))
                  (v:label "z"))))
    (assert-equal '("a" "0" "1" "2" "z")
                  (mapcar (lambda (view) (v:view-prop view :text)) (v:view-children column)))))

(define-test a-nest-of-containers-is-a-nest-of-views ()
  (let ((view (b:padding (:all 20)
                (b:column (:gap 12)
                  (v:label "status" :id :status)
                  (b:row (:gap 8) (v:button "A") (v:button "B"))))))
    (assert-eq :padding (v:view-type view))
    (let ((column (first (v:view-children view))))
      (assert-eq :column (v:view-type column))
      (assert-eql 12 (v:view-prop column :gap))
      (assert-equal '(:label :row) (mapcar #'v:view-type (v:view-children column))))))

(define-test a-component-is-described-by-its-body ()
  (let* ((count 0)
         (view (b:component (:key 7)
                 (incf count)
                 (v:label "x"))))
    (assert-eq :component (v:view-type view))
    (assert-eql 7 (v:view-prop view :key))
    (assert-eql 0 count)
    (let ((described (funcall (v:view-prop view :thunk))))
      (assert-equalp (v:label "x") described)
      (assert-eql 1 count))))

(define-test a-container-of-one-child-wants-exactly-one-form ()
  (assert-error 'error (macroexpand-1 '(b:padding (:all 1))))
  (assert-error 'error (macroexpand-1 '(b:padding (:all 1) a b)))
  (assert-error 'error (macroexpand-1 '(b:panel () a b)))
  (assert-error 'error (macroexpand-1 '(b:center () a b))))
