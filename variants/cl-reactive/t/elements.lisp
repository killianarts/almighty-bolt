(defpackage #:almighty-bolt-variant-reactive/t/elements
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:v #:almighty-bolt-variant-reactive/views)
                    (#:e #:almighty-bolt-variant-reactive/elements)
                    (#:s #:almighty-bolt-variant-reactive/signals)
                    (#:n #:almighty-bolt-variant-retained/node)
                    (#:w #:almighty-bolt-variant-retained/widgets)
                    (#:i #:almighty-bolt-variant-retained/inputs)))

(in-package #:almighty-bolt-variant-reactive/t/elements)

;;; The reconciler without a variant: views mounted into elements and nodes, and changed.

(defvar *dirty* '())

(defun mount (view)
  "The element for VIEW, with the components that are told they changed collected in *DIRTY*."
  (setf *dirty* '())
  (e:mount view nil nil (lambda (element) (pushnew element *dirty*))))

(defun kids (node)
  (coerce (n:node-children node) 'list))

(defun texts (node)
  (mapcar #'w:label-text (kids node)))

;;; A tree is mounted under a component, so that it can be described again.

(defun app (signal-thunk)
  "A mounted component whose description is whatever SIGNAL-THUNK returns now."
  (mount (v:component signal-thunk)))

(define-test mounting-makes-a-node-for-each-view ()
  (let* ((root (mount (v:column (v:label "one" :id :one) (v:button "two" :id :two) :gap 5)))
         (node (e:element-node root)))
    (assert-eql 2 (length (kids node)))
    (assert-eql :one (n:node-id (first (kids node))))
    (assert-true (w:label-p (first (kids node))))
    (assert-true (w:button-p (second (kids node))))
    (assert-equal "two" (w:button-text (second (kids node))))))

(define-test a-nil-among-the-children-is-left-out ()
  (let* ((root (mount (v:row (v:label "a") nil (v:label "b"))))
         (node (e:element-node root)))
    (assert-equal '("a" "b") (texts node))))

(define-test describing-again-changes-the-nodes-that-differ-and-keeps-the-rest ()
  (let* ((text (s:make-signal "one"))
         (root (app (lambda ()
                      (v:column (v:label (s:value text) :id :changing)
                                (v:label "same" :id :static)))))
         (node (e:element-node root))
         (changing (first (kids node)))
         (static (second (kids node))))
    (setf (s:value text) "two")
    (assert-eql 1 (length *dirty*))
    (e:rebuild (first *dirty*))
    (assert-true (eq node (e:element-node root)))
    (assert-true (eq changing (first (kids node))))
    (assert-true (eq static (second (kids node))))
    (assert-equal '("two" "same") (texts node))))

(define-test children-can-be-added-and-taken-away ()
  (let* ((count (s:make-signal 1))
         (root (app (lambda ()
                      (apply #'v:column
                             (loop :for i :below (s:value count)
                                   :collect (v:label (princ-to-string i)))))))
         (node (e:element-node root))
         (first-label (first (kids node))))
    (setf (s:value count) 3)
    (e:rebuild (first *dirty*))
    (assert-equal '("0" "1" "2") (texts node))
    (assert-true (eq first-label (first (kids node))))
    (setf *dirty* '())
    (setf (s:value count) 1)
    (e:rebuild (first *dirty*))
    (assert-equal '("0") (texts node))))

(define-test keyed-children-keep-their-nodes-when-they-move ()
  (let* ((order (s:make-signal '(:a :b :c)))
         (root (app (lambda ()
                      (apply #'v:column
                             (loop :for key :in (s:value order)
                                   :collect (v:label (string-downcase (symbol-name key))
                                                     :key key))))))
         (node (e:element-node root))
         (by-text (mapcar (lambda (label) (cons (w:label-text label) label)) (kids node))))
    (setf (s:value order) '(:c :a :b))
    (e:rebuild (first *dirty*))
    (assert-equal '("c" "a" "b") (texts node))
    (dolist (label (kids node))
      (assert-true (eq label (cdr (assoc (w:label-text label) by-text :test #'string=)))))))

(define-test a-different-kind-of-view-in-the-same-place-makes-a-new-node ()
  (let* ((as-button (s:make-signal nil))
         (root (app (lambda ()
                      (v:column (if (s:value as-button)
                                    (v:button "x" :id :thing)
                                    (v:label "x" :id :thing))))))
         (node (e:element-node root))
         (before (first (kids node))))
    (assert-true (w:label-p before))
    (setf (s:value as-button) t)
    (e:rebuild (first *dirty*))
    (assert-true (w:button-p (first (kids node))))
    (assert-false (eq before (first (kids node))))))

(define-test a-property-that-a-node-cannot-change-makes-a-new-node ()
  (let* ((gap (s:make-signal 4))
         (root (app (lambda () (v:column (v:label "a") (v:label "b") :gap (s:value gap)))))
         (before (e:element-node root)))
    (setf (s:value gap) 9)
    (e:rebuild (first *dirty*))
    (let ((after (e:element-node root)))
      (assert-false (eq before after))
      (assert-equal '("a" "b") (texts after)))))

(define-test a-label-colour-is-set-and-put-back-in-place ()
  (let* ((color (s:make-signal nil))
         (root (app (lambda () (v:column (v:label "a" :color (s:value color)) :gap 4))))
         (node (e:element-node root))
         (label (first (kids node)))
         (default (w:label-color label)))
    (setf (s:value color) #xFF8040FF)
    (e:rebuild (first *dirty*))
    (assert-true (eq label (first (kids (e:element-node root)))))
    (assert-eql #xFF8040FF (w:label-color label))
    (setf (s:value color) nil)
    (e:rebuild (first *dirty*))
    (assert-true (eq label (first (kids (e:element-node root)))))
    (assert-eql default (w:label-color label))))

(define-test the-root-node-of-a-component-can-change-kind ()
  (let* ((flag (s:make-signal nil))
         (root (app (lambda ()
                      (if (s:value flag) (v:button "b") (v:label "a")))))
         (before (e:element-node root)))
    (assert-true (w:label-p before))
    (setf (s:value flag) t)
    (e:rebuild (first *dirty*))
    (assert-true (w:button-p (e:element-node root)))))

;;; --- components ---

(define-test only-the-component-that-read-a-signal-is-described-again ()
  (let* ((outer-runs 0)
         (inner-runs 0)
         (signal (s:make-signal 1))
         (root (app (lambda ()
                      (incf outer-runs)
                      (v:column (v:label "static")
                                (v:component (lambda ()
                                               (incf inner-runs)
                                               (v:label (princ-to-string (s:value signal))
                                                        :id :shown))))))))
    (assert-eql 1 outer-runs)
    (assert-eql 1 inner-runs)
    (setf (s:value signal) 2)
    (assert-eql 1 (length *dirty*))
    (e:rebuild (first *dirty*))
    (assert-eql 1 outer-runs)
    (assert-eql 2 inner-runs)
    (let ((label (second (kids (first (kids (e:element-node root)))))))
      (declare (ignorable label)))
    (assert-equal "2" (w:label-text (second (kids (e:element-node root)))))))

(define-test a-signal-read-in-the-outer-component-describes-the-inner-one-again-too ()
  (let* ((inner-runs 0)
         (outer (s:make-signal 1))
         (root (app (lambda ()
                      (s:value outer)
                      (v:column (v:component (lambda ()
                                               (incf inner-runs)
                                               (v:label "inner"))))))))
    (declare (ignorable root))
    (setf (s:value outer) 2)
    (e:rebuild (first *dirty*))
    ;; The outer component gave the inner a new function, which may describe something else.
    (assert-eql 2 inner-runs)))

(define-test a-component-that-was-removed-hears-nothing-more ()
  (let* ((show (s:make-signal t))
         (signal (s:make-signal 1))
         (root (app (lambda ()
                      (v:column (when (s:value show)
                                  (v:component (lambda ()
                                                 (v:label (princ-to-string (s:value signal))
                                                          :key :inner))
                                               :key :inner)))))))
    (declare (ignorable root))
    (setf (s:value show) nil)
    (e:rebuild (first *dirty*))
    (setf *dirty* '())
    (setf (s:value signal) 2)
    (assert-eql 0 (length *dirty*))))

;;; --- common properties ---

(define-test visibility-and-enabling-are-applied-and-changed ()
  (let* ((flag (s:make-signal t))
         (root (app (lambda ()
                      (v:column (v:button "b" :visible (s:value flag) :enabled (s:value flag))))))
         (button (first (kids (e:element-node root)))))
    (assert-true (n:node-visible button))
    (setf (s:value flag) nil)
    (e:rebuild (first *dirty*))
    (assert-true (eq button (first (kids (e:element-node root)))))
    (assert-false (n:node-visible button))
    (assert-false (n:node-enabled button))))

(define-test an-input-shows-what-the-view-says-even-if-it-was-changed-by-hand ()
  (let* ((root (app (lambda () (v:column (v:text-field :value "fixed" :id :f)))))
         (field (first (kids (e:element-node root)))))
    (setf (i:text-field-text field) "typed")
    ;; Nothing the component reads changed, but describing it again puts the text back.
    (e:rebuild root)
    (assert-equal "fixed" (i:text-field-text field))))

;;; --- the description of a view ---

(define-test a-view-says-what-it-was-given-and-the-defaults-for-the-rest ()
  (let ((plain (v:label "t")))
    (assert-equal "t" (v:view-prop plain :text))
    (assert-eql 15 (v:view-prop plain :size))
    (assert-false (v:view-prop plain :color))
    (assert-false (v:view-prop plain :id))
    (assert-eql 0 (v:view-prop plain :flex))
    (assert-true (v:view-prop plain :visible))
    (assert-true (v:view-prop plain :enabled))
    (assert-false (v:view-prop plain :key))
    ;; A property that its kind does not have is nothing, not an error.
    (assert-false (v:view-prop plain :fraction))
    (assert-false (v:view-prop plain :no-such-property)))
  (let ((given (v:label "u" :id :x :size 20 :color 7 :flex 2 :visible nil :enabled nil :key :k)))
    (assert-equal "u" (v:view-prop given :text))
    (assert-eql 20 (v:view-prop given :size))
    (assert-eql 7 (v:view-prop given :color))
    (assert-eql :x (v:view-prop given :id))
    (assert-eql 2 (v:view-prop given :flex))
    (assert-false (v:view-prop given :visible))
    (assert-false (v:view-prop given :enabled))
    (assert-eql :k (v:view-prop given :key)))
  ;; Each of the four that have defaults can be the only one that differs.
  (assert-eql 3 (v:view-prop (v:label "t" :flex 3) :flex))
  (assert-false (v:view-prop (v:label "t" :visible nil) :visible))
  (assert-true (v:view-prop (v:label "t" :visible nil) :enabled))
  (assert-eql 0 (v:view-prop (v:label "t" :key 1) :flex))
  (assert-eql 1 (v:view-prop (v:label "t" :key 1) :key))
  (let ((progress (v:progress :fraction 1/2 :width 99)))
    (assert-eql 1/2 (v:view-prop progress :fraction))
    (assert-eql 99 (v:view-prop progress :width))))

(define-test every-kind-of-view-keeps-the-properties-it-was-given ()
  (let ((canvas (v:canvas :width 5 :height 6 :data :d :paint :p :on-press :a :on-move :b :on-exit :c
                          :on-drag :e :on-release :f :on-key :g :on-text :h :on-composition :i
                          :on-wheel :j :focusable 1)))
    (loop :for (key value) :on '(:width 5 :height 6 :data :d :paint :p :on-press :a :on-move :b
                                 :on-exit :c :on-drag :e :on-release :f :on-key :g :on-text :h
                                 :on-composition :i :on-wheel :j :focusable t)
            :by #'cddr
          :do (assert-eql value (v:view-prop canvas key) key)))
  (let ((field (v:text-field :value "v" :width 9 :on-change :c :on-submit :s :invalid 1)))
    (assert-equal "v" (v:view-prop field :value))
    (assert-eql :s (v:view-prop field :on-submit))
    (assert-eq t (v:view-prop field :invalid)))
  (let ((panel (v:panel (v:label "c") :all 3 :left 4 :color 8 :radius 2)))
    (assert-eql 4 (v:view-prop panel :left))
    (assert-eql 3 (v:view-prop panel :top))
    (assert-eql 8 (v:view-prop panel :color))
    (assert-eql 2 (v:view-prop panel :radius))
    (assert-eql 1 (length (v:view-children panel))))
  (assert-eql 2 (v:view-prop (v:slider :value 2 :minimum 0 :maximum 9 :on-change :c) :value))
  (assert-eql 4 (v:view-prop (v:choice '("a" "b") :selected 4) :selected))
  (assert-eql 3 (v:view-prop (v:list-box :items '(1) :selected 3 :rows 2) :selected))
  (assert-eql :c (v:view-prop (v:row (v:label "a") :gap 5 :cross-align :c) :cross-align))
  (assert-eql 2 (length (v:view-children (v:column (v:label "a") nil (v:label "b"))))))

(define-test a-description-of-a-label-and-of-a-canvas-are-small ()
  ;; A component is described again whenever a signal it read changes, so what a description
  ;; allocates is paid every frame. A label is a structure of five slots and a vector of three
  ;; (96 bytes); a canvas has fourteen properties (176). They were 290 and 670 as property lists.
  (flet ((bytes-for (function)
           (dotimes (i 1000) (funcall function))
           (sb-ext:gc :full t)
           (let ((before (sb-ext:get-bytes-consed)))
             (dotimes (i 20000) (funcall function))
             (/ (- (sb-ext:get-bytes-consed) before) 20000.0))))
    (assert-true (< (bytes-for (lambda () (v:label "t" :id :a))) 130))
    (assert-true (< (bytes-for (lambda () (v:progress :id :a :fraction 0.5 :width 100))) 110))
    (assert-true (< (bytes-for (lambda () (v:canvas :id :a :width 5 :height 6 :data 1 :paint :p
                                                    :on-press :q)))
                    220))))
